{
  "providers": {
    "openai-chatgpt-oauth": {
      "auth_type": "oauth",
      "default_protocol": "openai-responses",
      "responses": {
        "lite": false
      },
      "models": {
        "gpt-6-astra": {
          "tools": true,
          "reasoning": true,
          "reasoning_levels": ["low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "gpt-6.1-sol": {
          "tools": true,
          "reasoning": true,
          "reasoning_levels": ["low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "gpt-6.1-terra": {
          "tools": true,
          "reasoning": true,
          "reasoning_levels": ["low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "gpt-6-luna": {
          "tools": true,
          "reasoning": true,
          "reasoning_levels": ["low", "medium", "high", "xhigh", "max"]
        },
        "gpt-5.6-sol": {
          "tools": true,
          "reasoning": true,
          "reasoning_levels": ["none", "low", "medium", "high", "xhigh", "max"],
          "responses": {
            "lite": true
          }
        },
        "gpt-5.6-terra": {
          "tools": true,
          "reasoning": true,
          "reasoning_levels": ["none", "low", "medium", "high", "xhigh", "max"],
          "responses": {
            "lite": true
          }
        },
        "gpt-5.6-luna": {
          "tools": true,
          "reasoning": true,
          "reasoning_levels": ["none", "low", "medium", "high", "xhigh", "max"],
          "responses": {
            "lite": true
          }
        },
        "gpt-5.5": {
          "tools": true,
          "reasoning": true,
          "reasoning_levels": ["none", "low", "medium", "high", "xhigh"]
        }
      }
    },
    "opencode-go": {
      "models_dev": {
        "provider": "opencode-go"
      },
      "auth_type": "api_key",
      "default_protocol": "openai-chat",
      "openai_chat": {
        "include_stream_usage": true,
        "include_reasoning_content": true
      },
      "models": {
        "gemini-4-argon": {
          "reasoning_levels": ["low", "medium", "high", "max"]
        }
      }
    },
    "openrouter": {
      "models_dev": {
        "provider": "openrouter",
        "only": ["google/gemini-nano-banana-2.1"]
      },
      "auth_type": "api_key",
      "default_protocol": "openai-chat",
      "models": {
        "~typesafe/jev-latest": {
          "tools": true,
          "reasoning": true
        }
      }
    }
  }
}
