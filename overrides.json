{
  "providers": {
    "openai-chatgpt-oauth": {
      "auth_type": "oauth",
      "default_protocol": "openai-responses",
      "title": "Codex (ChatGPT)",
      "endpoints": {
        "openai-responses": "https://chatgpt.com/backend-api/codex"
      },
      "responses": {
        "lite": false
      },
      "models": {
        "gpt-6.2-sol": {
          "tools": true,
          "reasoning": true,
          "reasoning_levels": ["low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "gpt-6.2-astra": {
          "tools": true,
          "reasoning": true,
          "reasoning_levels": ["low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "gpt-6-astra": {
          "tools": true,
          "reasoning": true,
          "reasoning_levels": ["low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "gpt-6-sol": {
          "tools": true,
          "reasoning": true,
          "reasoning_levels": ["low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "gpt-6.1-sol": {
          "tools": true,
          "reasoning": true,
          "reasoning_levels": ["low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "gpt-6.1-terra": {
          "tools": true,
          "reasoning": true,
          "reasoning_levels": ["low", "medium", "high", "xhigh", "max", "ultra"]
        },
        "gpt-6-luna": {
          "tools": true,
          "reasoning": true,
          "reasoning_levels": ["low", "medium", "high", "xhigh", "max"]
        },
        "gpt-5.5": {
          "tools": true,
          "reasoning": true,
          "reasoning_levels": ["none", "low", "medium", "high", "xhigh"]
        }
      }
    },
    "opencode-go": {
      "models_dev": {
        "provider": "opencode-go"
      },
      "auth_type": "api_key",
      "default_protocol": "openai-chat",
      "title": "OpenCode Go",
      "endpoints": {
        "openai-chat": "https://opencode.ai/zen/go/v1",
        "openai-responses-api": "https://opencode.ai/zen/go/v1",
        "anthropic-messages": "https://opencode.ai/zen/go/v1",
        "google-generate-content": "https://opencode.ai/inference/go/google/v1beta"
      },
      "session_header": "x-opencode-session",
      "openai_chat": {
        "include_stream_usage": true,
        "include_reasoning_content": true
      },
      "models": {
        "gemini-4-argon": {
          "reasoning_levels": ["low", "medium", "high", "max"]
        }
      }
    },
    "openrouter": {
      "models_dev": {
        "provider": "openrouter",
        "only": ["google/gemini-nano-banana-2.1"]
      },
      "auth_type": "api_key",
      "default_protocol": "openai-chat",
      "title": "OpenRouter",
      "endpoints": {
        "openai-chat": "https://openrouter.ai/api/v1"
      },
      "models": {
        "~typesafe/jev-latest": {
          "tools": true,
          "reasoning": true
        }
      }
    },
    "deepseek": {
      "models_dev": {
        "provider": "deepseek",
        "only": ["deepseek-flash", "deepseek-v4-pro"]
      },
      "auth_type": "api_key",
      "default_protocol": "openai-chat",
      "title": "DeepSeek",
      "endpoints": {
        "openai-chat": "https://api.deepseek.com"
      },
      "openai_chat": {
        "include_stream_usage": true,
        "include_reasoning_content": true
      }
    },
    "commandcode": {
